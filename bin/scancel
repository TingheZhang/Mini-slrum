#!/usr/bin/env python3
import sys
import os
import argparse
import subprocess

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(BASE_DIR, "lib"))

from mslurm_db import MiniSlurmDB

def main():
    parser = argparse.ArgumentParser(description="Mini-Slurm scancel")
    parser.add_argument("job_id", type=int, help="Job ID to cancel")
    args = parser.parse_args()

    job_id = args.job_id
    db_path = os.path.join(BASE_DIR, "var", "mslurm.db")
    db = MiniSlurmDB(db_path)

    action, job = db.request_cancel(job_id)
    if action is None:
        sys.stderr.write(f"scancel: error: Job {job_id} not found\n")
        sys.exit(1)

    if action == "TERMINATED":
        sys.stderr.write(f"scancel: job {job_id} has already terminated with status {job['status']}\n")
        return

    if action == "CANCELLED":
        print(f"Cancelled pending job {job_id}")
        return

    # action == "CANCEL_REQUESTED"
    # 1. Place .cancel file in shared directory so executor halts
    job_dir = f"/mnt/share/mini-slurm/jobs/{job_id}"
    os.makedirs(job_dir, exist_ok=True)
    with open(os.path.join(job_dir, ".cancel"), "w") as f:
        f.write("CANCEL\n")

    # 2. If remote PGID is known, send immediate SIGTERM to process group
    node = job.get("allocated_node")
    pgid = job.get("remote_pgid")
    if node and pgid:
        cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", node, f"kill -TERM -{pgid} 2>/dev/null || true"]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    print(f"Cancellation requested for job {job_id} on {node}")

if __name__ == "__main__":
    main()
